# Meeting-to-Execution AI Configuration
# Default: Local/Demo-First Mode (Works 100% offline without API keys)

ENVIRONMENT=development
DATABASE_URL=sqlite:///./meeting_execution.db

# Speech-to-Text Model (tiny, base, small, medium)
WHISPER_MODEL_SIZE=tiny
WHISPER_COMPUTE_TYPE=int8

# LLM Provider: auto | local | gemini | ollama
LLM_PROVIDER=auto

# Optional Google Gemini API Key (leaves blank for Local Offline Heuristics)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Ollama Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
